rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // WARNING:
      // The current app does not use Firebase Auth for real server-side access control.
      // These rules keep the system functional in production, but they are not secure
      // for a public app. The next recommended step is to migrate login/account creation
      // to Firebase Auth (or backend-issued auth) and then restrict access by role.
      allow read, write: if true;
    }
  }
}
